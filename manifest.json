{
  "manifest_version": 3,
  "name": "Coupons Vault",
  "version": "0.1.0",
  "description": "Store and surface discount codes on matching retailer sites.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.de/*",
    "*://*.bestsecret.com/*",
    "*://*.c-and-a.com/*",
    "*://*.zalando.com/*",
    "*://*.zalando.de/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Coupons Vault"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.de/*",
        "*://*.bestsecret.com/*",
        "*://*.c-and-a.com/*",
        "*://*.zalando.com/*",
        "*://*.zalando.de/*"
      ],
      "js": ["lib/matcher.js", "content/content-script.js"],
      "css": ["content/badge.css"],
      "run_at": "document_idle"
    }
  ]
}
