{
  "manifest_version": 3,
  "name": "Coupons Vault",
  "version": "0.1.0",
  "description": "Store and surface discount codes on matching retailer sites.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Coupons Vault"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/matcher.js", "lib/fieldDetector.js", "content/content-script.js"],
      "css": ["content/badge.css"],
      "run_at": "document_idle"
    }
  ]
}
